# Local dev: copy to apps/web/.env.local. On Vercel set these three (Root Directory apps/web).
# Never put the service-role key here; the web app uses the anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin used in magic-link redirects (e.g. https://app.example.com); falls back to request origin
NEXT_PUBLIC_SITE_URL=
