{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": ["src/**/*", "tests/**/*", "scripts/lib/**/*", "scripts/legacy/**/*", "scripts/seed-brand.ts", "scripts/migrate-sqlite.ts"],
  "exclude": ["node_modules", "dist"]
}
