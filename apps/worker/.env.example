# --- Required ---
# Postgres connection string (Supabase pooler URL).
DATABASE_URL=
# Supabase project URL (storage).
SUPABASE_URL=
# Supabase service-role key (server only; never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic API key used by the agent.
ANTHROPIC_API_KEY=

# --- Worker runtime ---
# Platform owner email; receives failure notifications when no brand recipient is given.
OWNER_EMAIL=
# Parallel run-loop slots, 1-8 (default 2).
WORKER_CONCURRENCY=2
# Scratch dir for materialized brands, relative to apps/worker (default tmp/runs).
TMP_ROOT=tmp/runs
# Set to 1 inside Docker so Chromium launches with --no-sandbox (the Dockerfile sets it).
PUPPETEER_NO_SANDBOX=
# Path to a system Chromium (the Dockerfile sets /usr/bin/chromium); unset locally to use Puppeteer's download.
PUPPETEER_EXECUTABLE_PATH=

# --- Postiz publishing ---
# Postiz API key.
POSTIZ_API_KEY=
# Postiz public API base URL.
POSTIZ_BASE_URL=https://app.postiz.com/api/public/v1
# Stable named-tunnel URL for media fetched by Postiz; no auto-detection, leave empty if unused.
POSTIZ_TUNNEL_URL=
# Brand id (brands.id uuid) that owns the single shared Postiz account (carephoto); other brands are refused.
POSTIZ_BRAND_ID=
# Local posting time override (HH:MM) used by schedule-post when set.
SCHEDULE_TIME=

# --- Agent tools ---
# Firecrawl API key for scraping hot topics and sources.
FIRECRAWL_API_KEY=
# Brandfetch API key for brand asset lookup.
BRANDFETCH_API_KEY=
# carephoto Agent API key (ck_live_...), required when brand.imageGeneration is enabled.
CAREPHOTO_API_KEY=
# carephoto Agent API base URL.
CAREPHOTO_BASE_URL=https://carephoto.art/api/v1/agent

# --- Email notifications (SMTP) ---
# Fallback recipient used by sendNotification when no recipient is given.
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Legacy / local scripts ---
# Brand slug used by older scripts.
BRAND=carephoto
