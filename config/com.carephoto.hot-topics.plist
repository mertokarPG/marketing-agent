<?xml version="1.0" encoding="UTF-8"?>
<!--
Launchd spec to run the hot-topics scraper nightly at 03:00 local.

Install:
  cp config/com.carephoto.hot-topics.plist ~/Library/LaunchAgents/
  launchctl load ~/Library/LaunchAgents/com.carephoto.hot-topics.plist

Uninstall:
  launchctl unload ~/Library/LaunchAgents/com.carephoto.hot-topics.plist
  rm ~/Library/LaunchAgents/com.carephoto.hot-topics.plist

Inspect logs:
  tail -f /tmp/carephoto-hot-topics.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carephoto.hot-topics</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/mertokar/Documents/GitHub/marketing-agent &amp;&amp; /opt/homebrew/bin/npx tsx scripts/scrape-hot-topics.ts</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/carephoto-hot-topics.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/carephoto-hot-topics.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/mertokar/Documents/GitHub/marketing-agent</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
